{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.4",
  "schemes" : [
    {
      "if" : {
        "device" : {
          "category" : "trackpad",
          "productID" : "0x0",
          "productName" : "Apple Internal Keyboard \/ Trackpad",
          "vendorID" : "0x0"
        }
      },
      "pointer" : {
        "disableAcceleration" : false
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xf503",
          "productName" : "VGN Mouse 2.4G Receiver",
          "vendorID" : "0x3554"
