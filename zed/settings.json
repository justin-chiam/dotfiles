// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "edit_predictions": {
    "provider": "none"
  },
  "tabs": {
    "git_status": true,
    "file_icons": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "Menlo",
  "icon_theme": "Soft Charmed Icons",
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "restore_on_startup": "launchpad",
  "terminal": {
    "font_size": 12.0,
    "font_family": "MesloLGS NF",
    "copy_on_select": true
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "file_types": {
    "c": [
      "*.h"
    ]
  },
  "show_whitespaces": "none",
  "hover_popover_enabled": false,
  "format_on_save": "off",
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "padding": 4,
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/*.dSYM"
  ],
  "languages": {
    "C": {
      "wrap_guides": [
        80
      ],
      "show_wrap_guides": true
    },
    "LaTeX": {
      "soft_wrap": "editor_width"
    },
    "Plain Text": {
      "soft_wrap": "editor_width"
    },
    "Python": {
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "charmed-icons": true,
    "discord-presence": true,
    "basedpyright": true,
    "ruff": true,
    "svelte": true,
    "typst": true,
    "latex": true,
    "dockerfile": true,
    "docker-compose": true,
    "toml": true
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "fast": false
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Catppuccin Mocha - No Italics",
  },
  "theme_overrides": {
    "Catppuccin Mocha - No Italics": {
      "border": "#1E1E2E",
      "border.variant": "#1E1E2E",
    },
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "title_bar": {
    "show_user_picture": false,
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--header-insertion=never"
        ]
      }
    },
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "basic",
            "inlayHints": {
              "variableTypes": false,
              "genericTypes": false,
              "functionReturnTypes": false,
              "callArgumentNames": false
            }
          }
        }
      }
    },
    "discord_presence": {
      "initialization_options": {
        "application_id": "1263505205522337886",
        "base_icons_url": "https://raw.githubusercontent.com/xhyrom/zed-discord-presence/main/assets/icons/",

        "state": "Editing a {language:u} file",
        "details": null,

        "large_image": "{base_icons_url}/{language:lo}.png",
        "large_text": "{language:u}",
        "small_image": "{base_icons_url}/zed.png",
        "small_text": "Zed",

        "idle": {
          "timeout": 300,
          "action": "change_activity",
          "state": "Idling",
          "details": null,
          "large_image": "{base_icons_url}/zed.png",
          "large_text": "Zed",
          "small_image": "{base_icons_url}/idle.png",
          "small_text": "Idle"
        },

        "rules": {
          "mode": "blacklist",
          "paths": []
        },

        "git_integration": true
      }
    }
  }
}
